<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.9</version>
        <relativePath/>
    </parent>

    <groupId>com.dostavahrane</groupId>
    <artifactId>api-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>api-gateway</name>
    <description>Centralna ulazna tacka za sve servise - PDS projekat</description>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
    </properties>

    <!-- NAPOMENA: ovaj projekat NEMA spring-boot-starter-web kao ostali servisi!
         Spring Cloud Gateway interno radi na drugacijoj (reaktivnoj, WebFlux) osnovi
         umesto klasicnog Tomcat-a. Nama to ne menja gotovo nista u praksi - ne pisemo
         reaktivni kod, samo podesavamo rute kroz YAML - ali NE SME da se meša sa
         spring-boot-starter-web u istom projektu, pa ga zato ovde nema. -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <!-- Gateway mora i sam da bude Eureka klijent - jedino tako moze da pita
             "gde se trenutno nalazi user-service?" umesto da mu adresa bude fiksirana. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- Omogucava load balancing - kad bi postojale 2 instance restaurant-service,
             ovo je biblioteka koja bira izmedju njih (round-robin po podrazumevanom). -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- NOVO: Actuator. Kod Gateway-a je posebno korisno - dobijamo
             i /actuator/gateway/routes, gde se vidi TACNO koje su rute
             trenutno ucitane, korisno za debugovanje. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
